# Dependencies
node_modules/

# Build output
dist/
build/
.twenty/
*.tsbuildinfo

# Secrets — never commit values. Licence keys, API keys, and Twenty
# credentials belong in the team secret store / Twenty application variables.
.env
.env.*
!.env.example
*.key
*.pem
credentials.md

# Internal operations notes. This repository is public. Infrastructure hosts,
# container numbers, credential-store locations, provisioned licensing ids and
# the workstation dev-loop recipe live here and are never committed. Their
# long-term home is the private infrastructure repository; see the header of
# the file itself.
INTERNAL_OPS.md

# The commercial origin plan. Kept as a local historical record rather than
# rewritten — it carries pricing, margin and internal-naming detail, and
# PRODUCT_SPEC.md / ARCHITECTURE.md supersede it on everything a developer needs.
gatekeeper-product-plan.html

# Playwright — browser binaries live outside the repo, but everything a run
# produces lands inside it. The saved sign-in session is ignored for the same
# reason a credential would be, even though it only opens the dev container.
test-results/
playwright-report/
blob-report/
playwright/.cache/
e2e/.auth/
e2e/shots/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# The calibration pack is the product a licence buys. This repository is
# public, so the payload and its signed envelope are never committed — the
# system of record is the licensing service, retrievable with
# `node ops/calibration/publish.mjs fetch`.
ops/calibration/*.json

# Local archive of the pre-rebuild commit history. Contains internal hostnames
# and paths from before the docs were sanitised - never publish this.
COMMIT_HISTORY_ARCHIVE.md
